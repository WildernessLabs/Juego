<Project Sdk="Meadow.Sdk/1.1.0">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageIcon>icon.png</PackageIcon>
    <Authors>Wilderness Labs, Inc</Authors>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Juego</AssemblyName>
    <Company>Wilderness Labs, Inc</Company>
    <PackageProjectUrl>https://github.com/WildernessLabs/Juego</PackageProjectUrl>
    <PackageId>Meadow.Juego</PackageId>
    <RepositoryUrl>https://github.com/WildernessLabs/Juego</RepositoryUrl>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
